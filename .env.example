# E-mail (Gmail via nodemailer) — de offerte- en contactformulieren versturen
# via een Gmail-account met een App-wachtwoord (https://myaccount.google.com/apppasswords).
# Zet deze twee ook in Vercel → Settings → Environment Variables, anders faalt de
# verzending met "E-mail kon niet worden verstuurd".
GMAIL_USER=info@kunststofkozijnnodig.nl
GMAIL_APP_PASSWORD=xxxx xxxx xxxx xxxx

# Waar offerte-/contactaanvragen heen gaan (optioneel; standaard = site.email)
QUOTE_TO_EMAIL=info@kunststofkozijnnodig.nl

# Supabase (projecten & admin)
NEXT_PUBLIC_SUPABASE_URL=https://xxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=xxxx
SUPABASE_SERVICE_ROLE_KEY=xxxx

# AI SEO agent (Anthropic) — https://console.anthropic.com
ANTHROPIC_API_KEY=sk-ant-xxxxxxxx

# Public site URL (voor sitemap & canonical tags)
NEXT_PUBLIC_SITE_URL=https://kunststofkozijnnodig.nl
